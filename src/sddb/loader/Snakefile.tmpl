# Generated by sddb.loader.materialize(runner="snakemake") for $dest
# and written again on every run: edit the call, not this file.
#
# validate (the default target) needs every member's done marker. Each member left to write has a rule
# dataset_<uid>, whose output is its marker; it runs the whole adapter chain for that member. fit_stain, if the
# chain fits a stain reference, fits it once on all members first. config.yaml holds what the jobs share.

PYTHON = $python
STATE = $state


rule validate:
    input:
$done
    output:
        $valid,
    params:
        python=PYTHON,
        state=STATE,
    shell:
        "{params.python:q} -m sddb.loader._run_one validate {params.state:q}"
$rules
